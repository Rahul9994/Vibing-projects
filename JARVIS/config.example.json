        },
        "openai/gpt-oss-20b": {
          "reasoning_effort": "low"
        },
        "qwen/qwen3.8-27b": {
          "reasoning_effort": "none"
        }
      }
    },
    "opencode": {
      "label": "OpenCode Zen",
      "base_url": "https://opencode.ai/zen/v1",
      "key_env": "OPENCODE_API_KEY",
      "models": [],
